{
  "expo": {
    "name": "Bidify",
    "slug": "bidify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bidify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141923",
          "image": "./assets/images/bidify-logo.png",
          "imageWidth": 140,
          "android": {
            "backgroundColor": "#141923",
            "image": "./assets/images/bidify-logo.png",
            "imageWidth": 140
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bidify necesita acceder a tus fotos para subir tu DNI y las imágenes de tus productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
