# Base URL of the Sistema de Subastas FastAPI backend.
# Expo inlines EXPO_PUBLIC_* vars at build time. Copy to .env and adjust.
#
# Defaults if unset (see src/api/client.ts):
#   web / iOS simulator   -> http://localhost:8000
#   Android emulator      -> http://10.0.2.2:8000   (host loopback alias)
#   physical device       -> http://<expo-dev-host-LAN-IP>:8000
#
# On a physical device set this to your machine's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
